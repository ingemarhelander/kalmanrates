# KalmanOptimizeMain configuration
noisy_size 10
maxIter 100
mu 1E-2

# ---------------------------- Dataurval ----------------------------
# Väljer vilka dagar Kalmanfiltret byggs, optimeras och utvärderas
# out-of-sample på. Datum skrivs yyyy-mm-dd och båda ändpunkterna ingår.
#
# In-sample: dagarna som modellen byggs på (PCA och startparametrar).
# Kör buildKalmanModel efter varje ändring av in-sample eller
# out_of_sample_end; den sparar
# data/kalmanModel_<insample_start>_<insample_end>_<out_of_sample_end eller end>.mat.
# Saknas båda raderna används den gamla data/kalmanDebug.mat
# (2005-08-15 till 2025-04-17), och utvärderingen är då inte garanterat
# out-of-sample.
insample_start 2005-08-15
insample_end 2006-08-15
#
# Optimeringsperiod: parametrarna optimeras på de här dagarna. Måste ligga inom
# in-sample. Saknas raden används in-sample (utan in-sample: modellens
# första respektive sista dag).
optimize_start 2005-08-15
optimize_end 2006-08-15
#
# Out-of-sample-period: utvärderas med de optimerade parametrarna efter
# optimeringen. out_of_sample_start måste ligga efter insample_end. Ta bort
# out_of_sample_start för att hoppa över utvärderingen. Saknas
# out_of_sample_end används datans sista dag.
out_of_sample_start 2007-01-01
out_of_sample_end 2007-03-01
#
# Startpunkt: init (modellens egna startparametrar) eller saved
# (data/kalmanXoptAll.mat, måste ha lika många parametrar som modellen).
# Saknas raden: init med in-sample, annars saved.
start_point saved

# ---------------------------- Line search ----------------------------
# Kommentarer måste stå på egna rader (inte efter ett värde).
#
# Metod: polynomial (line_search_main) eller backtracking (line_search).
# Saknas raden används polynomial.
lineSearch polynomial

# Parametrar för polynomial. Ignoreras av backtracking. En rad som saknas
# får standardvärdet nedan.
#
# alpha ligger alltid i (0, 1]. Sökriktningen är skalad så att alpha = 1
# inte går förbi någon variansgräns. Första Kalman-körningen görs i
# initial_step_length_main: alpha = deltaF/(g'*d), begränsat till
# [alphaMin, 1]. Ett ogiltigt F (NaN/Inf) krymper steget. Sedan körs
# Kalman bara i ML-polynomets maximum, som hittas genom att gå längs
# polynomet från alpha = 0 med steg h tills derivatan blir negativ.
# h kostar inga Kalman-körningar, bara noggrannhet.
ls_alphaMin 1e-10
ls_h 1e-3
# Stopp när polynomets maximum ligger närmare än dMin*alphaMax från en
# redan utvärderad punkt, eftersom en körning där inte ger något nytt.
ls_dMin 5e-8
# Stopp när lutningen i bästa punkten är liten,
# |dF/dalpha| <= c * |startlutningen|. Mindre värde ger fler Kalman-körningar.
ls_c 0.05
# Högsta antal Kalman-körningar per sökriktning.
ls_maxEvals 25
# Minsta antal Kalman-körningar innan stoppet på liten lutning får gälla.
# 1: gäller direkt (påverkar ingenting). Hur minEvals ska användas är inte
# bestämt än.
ls_minEvals 1
# 1: skriv gradvalet (LR-testen) under varje rad i linjesökningens tabell.
ls_showDegree 0
# 1: spara indata till varje gradval i data/degreeLog_<tid>.mat, för
# replayDegreeSelection.m.
ls_saveFits 0
# Punkter i polynomanpassningen. 0: bara giltiga punkter i [0, alphaMax].
# 1: alla utvärderade punkter utom de med NaN/Inf, även de bortom alphaMax.
ls_fitAll 1
# Ingen punkt bättre än startpunkten än. 1: krymp steget till alphaMax/10.
# 0: anpassa polynomet ändå (krymper bara om färre än två giltiga punkter).
ls_shrink 0
# Utskrift. 0: linjesökningen skriver ingenting, main skriver en rad per
# iteration. 1: hela linjesökningstabellen för varje sökriktning.
ls_verbose 1

# ----------------------------- Denoise ---------------------------------
fixed_or_exact 1
# Fixed = 0, exact = 1
w_xi 1
wbar_xi 1

# Add more entries as key/value rows.
