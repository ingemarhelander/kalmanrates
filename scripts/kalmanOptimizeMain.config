# KalmanOptimizeMain configuration
noisy_size 3
maxIter 100
mu 1E-2

# ---------------------------- Line search ----------------------------
# Kommentarer måste stå på egna rader (inte efter ett värde).
#
# Metod: polynomial (line_search_main) eller backtracking (line_search).
# Saknas raden används backtracking.
lineSearch backtracking

# Parametrar för polynomial. Ignoreras av backtracking. En rad som saknas
# får standardvärdet nedan.
#
# Högsta antal nya punkter per sökriktning.
ls_maxEvals 20
# Stopp när |f'_j| <= c |f'_0| (lutningen har planat ut) och F har ökat.
# Mindre c ger noggrannare sökning men fler utvärderingar.
ls_c 0.2
# Minsta avstånd till en redan utvärderad punkt, relativt största steget (Req. 31).
ls_dMinRel 1e-3
# Stopp när förutsagd ökning < noiseFactor * sigmaF (brusnivån) och F har ökat.
# Större värde ger tidigare stopp.
ls_noiseFactor 1
# Stopp på lutning eller brus först när minst så många punkter (startpunkten
# inräknad) är utvärderade. 0 betyder ingen gräns.
ls_minPoints 0
# Gradval för ML-polynomet: lr (likelihood ratio) eller lag1 (autokorrelation).
ls_degreeMethod lr

# Denoise
fixed_or_exact 1
# Fixed = 0, exact = 1

# Add more entries as key/value rows.
