# KalmanOptimizeMain configuration
noisy_size 3
maxIter 100
mu 1E-2

# ---------------------------- Dataurval ----------------------------
# Väljer vilka dagar och kontrakt Kalmanfiltret byggs, tränas och testas på.
# Datum skrivs yyyy-mm-dd och båda ändpunkterna ingår.
#
# In-sample: dagarna som modellen byggs på (PCA och startparametrar).
# Kör buildKalmanModel efter varje ändring av in-sample eller test_end; den
# sparar data/kalmanModel_<insample_start>_<insample_end>_<test_end eller end>.mat.
# Saknas båda raderna används den gamla data/kalmanDebug.mat
# (2005-08-15 till 2025-04-17), och testet är då inte garanterat out-of-sample.
insample_start 2016-01-01
insample_end 2018-12-31
#
# Träningsperiod: parametrarna optimeras på de här dagarna. Måste ligga inom
# in-sample. Saknas raden används in-sample (utan in-sample: modellens
# första respektive sista dag).
train_start 2018-01-01
train_end 2018-12-31
#
# Out-of-sample-period: utvärderas med de optimerade parametrarna efter
# optimeringen. test_start måste ligga efter insample_end. Ta bort
# test_start för att hoppa över testet. Saknas test_end används datans
# sista dag.
test_start 2019-01-01
test_end 2019-03-31
#
# Startpunkt: init (modellens egna startparametrar) eller saved
# (data/kalmanXoptAll.mat, måste ha lika många parametrar som modellen).
# Saknas raden: init med in-sample, annars saved.
start_point init
#
# Veckodagar: all, eller en eller flera av mon,tue,wed,thu,fri.
# Exempel: wed ger en dag i veckan.
weekdays all
#
# Ta var n:te dag av dem som är kvar efter veckodagsfiltret (1 = alla).
# Exempel: weekdays all och day_step 5 ger ungefär en dag i veckan.
day_step 1
#
# Kontrakt: all, eller en kommalista utan mellanslag. Namnen är EONIA,
# 1W, 2W, 3W, 1M-11M, 1Y, 15M, 18M, 21M, 2Y-10Y (eller hela RIC:en, t.ex.
# EUREON3M=). Exempel: EONIA,1M,3M,6M,1Y,2Y,5Y,10Y
tenors all
#
# Samma veckodagar, day_step och kontrakt används för testperioden.

# ---------------------------- Line search ----------------------------
# Kommentarer måste stå på egna rader (inte efter ett värde).
#
# Metod: polynomial (line_search_main) eller backtracking (line_search).
# Saknas raden används polynomial.
lineSearch polynomial

# Parametrar för polynomial. Ignoreras av backtracking. En rad som saknas
# får standardvärdet nedan.
#
# Första Kalman-körningen görs i initial_step_length: alpha = deltaF/(g'*d),
# begränsat till [alphaMin, alphaMax]. alphaMax är också längsta tillåtna
# steg. Ett steg förbi en undre gräns (negativ varians) ger ogiltigt F, och
# då krymps steget. Sedan körs Kalman bara i ML-polynomets maximum, som hittas genom
# att gå längs polynomet från alpha = 0 med steg h*alphaMax tills derivatan
# blir negativ. h kostar inga Kalman-körningar, bara noggrannhet.
ls_alphaMax 20
ls_alphaMin 1e-3
ls_h 1e-3
# Stopp när polynomets maximum ligger närmare än dMin*alphaMax från en
# redan utvärderad punkt OCH den uppmätta lutningen där är liten,
# |dF/dalpha| <= c * |startlutningen|. Mindre värden ger fler Kalman-körningar.
ls_dMin 5e-4
ls_c 0.05
# Högsta antal Kalman-körningar per sökriktning.
ls_maxEvals 20
# Minsta antal Kalman-körningar innan stoppet på liten lutning får gälla.
# Om polynomets maximum redan är utvärderat stoppar sökningen ändå, eftersom
# en ny körning i samma punkt ger samma värde.
ls_minEvals 10

# ----------------------------- Denoise ---------------------------------
fixed_or_exact 1
# Fixed = 0, exact = 1
w_xi 1
wbar_xi 1

# Add more entries as key/value rows.
